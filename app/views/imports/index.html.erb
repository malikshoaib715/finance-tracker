<% content_for :title, "Imports" %>

<div class="flex items-center justify-between">
  <h1 class="text-2xl font-bold tracking-tight text-slate-900">Imports</h1>
  <%= link_to "Import a statement", new_import_path, class: "btn-primary" %>
</div>

<% if @imports.any? %>
  <ul class="card mt-6 divide-y divide-slate-100 p-0">
    <% @imports.each do |import| %>
      <li id="<%= dom_id(import) %>" class="flex items-center justify-between px-4 py-3 text-sm">
        <div>
          <p class="font-medium text-slate-900"><%= import.filename %></p>
          <p class="text-xs text-slate-500"><%= import.account.name %> · <%= l(import.created_at.to_date, format: :long) %></p>
        </div>
        <span class="rounded bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-600"><%= import.status.humanize %></span>
      </li>
    <% end %>
  </ul>
<% else %>
  <div class="card mt-6 py-12 text-center text-slate-600">No imports yet.</div>
<% end %>
