<li id="<%= dom_id(transaction) %>" class="flex items-center">
  <% if local_assigns[:selectable] %>
    <label class="pl-4">
      <span class="sr-only">Select <%= transaction.description %></span>
      <input type="checkbox" name="transaction_ids[]" value="<%= transaction.id %>" form="bulk-actions"
             class="form-checkbox" data-bulk-select-target="checkbox" data-action="bulk-select#update">
    </label>
  <% end %>
  <%= link_to edit_transaction_path(transaction), class: "flex min-w-0 flex-1 items-center gap-4 px-4 py-3 hover:bg-slate-50" do %>
    <div class="min-w-0 flex-1">
      <p class="truncate text-sm font-medium text-slate-900">
        <%= transaction.description %>
        <% if transaction.receipts.attached? %>
          <span class="ml-1 text-xs text-slate-400" title="Has receipts">📎</span>
        <% end %>
      </p>
      <p class="mt-0.5 flex items-center gap-2 text-xs text-slate-500">
        <%= transaction.account.name %>
        <% if transaction.category %>
          · <%= category_badge(transaction.category) %>
        <% end %>
        <% if (source = transaction.source) %>
          · <span class="rounded bg-slate-100 px-1.5 text-[10px] font-medium uppercase tracking-wide text-slate-500"><%= source %></span>
        <% end %>
        <% transaction.tags.each do |tag| %>
          <span class="text-slate-400">#<%= tag.name %></span>
        <% end %>
      </p>
    </div>
    <%= money_tag(transaction.signed_amount_cents, transaction.account.currency, class: "text-sm font-semibold") %>
  <% end %>
</li>
