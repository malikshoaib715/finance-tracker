<% content_for :title, "Transactions" %>

<div class="flex items-center justify-between">
  <h1 class="text-2xl font-bold tracking-tight text-slate-900">Transactions</h1>
  <div class="flex gap-3">
    <%= link_to "Recurring", recurring_transactions_path, class: "btn-secondary" %>
    <%= link_to "Import", new_import_path, class: "btn-secondary" %>
    <%= link_to "Export CSV", export_transactions_path(filter: @filter.attributes.compact), class: "btn-secondary", data: { turbo: false } %>
    <%= link_to "Transfer", new_transfer_path, class: "btn-secondary" %>
    <%= link_to "New transaction", new_transaction_path, class: "btn-primary" %>
  </div>
</div>

<%= render "filter", filter: @filter, accounts: @accounts, categories: @categories, tags: @tags %>
<%= render "month_nav", filter: @filter if @filter.by_month? %>
<%= render "totals", totals: @totals %>

<% if @entries.any? %>
  <div class="mt-6 space-y-6" data-controller="bulk-select">
    <%= form_with url: transactions_bulk_path, method: :patch, id: "bulk-actions",
          class: "hidden sticky top-2 z-10 flex flex-wrap items-center gap-3 rounded-xl bg-slate-900 px-4 py-3 text-sm text-white shadow-lg",
          data: { bulk_select_target: "bar" } do |f| %>
      <span data-bulk-select-target="count" class="font-medium"></span>
      <%= select_tag :category_id, options_from_collection_for_select(@categories, :id, :name),
            include_blank: "No category", class: "rounded-lg border-0 py-1.5 text-sm text-slate-900" %>
      <%= f.submit "Set category", class: "rounded-lg bg-white px-3 py-1.5 font-semibold text-slate-900 hover:bg-slate-100" %>
      <%= f.button "Delete", formmethod: :post, name: "_method", value: "delete",
            data: { turbo_confirm: "Delete the selected transactions?" },
            class: "rounded-lg bg-rose-600 px-3 py-1.5 font-semibold hover:bg-rose-500" %>
      <button type="button" data-action="bulk-select#clear" class="ml-auto text-slate-300 hover:text-white">Clear</button>
    <% end %>
    <% @entries.group_by(&:occurred_on).each do |date, entries| %>
      <section>
        <h2 class="mb-2 text-xs font-semibold uppercase tracking-wide text-slate-500">
          <%= date == Date.current ? "Today" : l(date, format: :long) %>
        </h2>
        <ul class="card divide-y divide-slate-100 p-0">
          <% entries.each do |entry| %>
            <%= entry.is_a?(Transaction) ? render(entry, selectable: true) : render(entry) %>
          <% end %>
        </ul>
      </section>
    <% end %>
  </div>
<% elsif @filter.active? %>
  <div class="card mt-6 py-12 text-center">
    <p class="text-slate-600">Nothing matches these filters.</p>
    <%= link_to "Clear filters", transactions_path, class: "link mt-2 inline-block" %>
  </div>
<% else %>
  <div class="card mt-6 py-12 text-center">
    <p class="text-slate-600">Nothing recorded in <%= l(@filter.period.first, format: "%B %Y") %>.</p>
    <%= link_to "Record your first one", new_transaction_path, class: "btn-primary mt-4" %>
  </div>
<% end %>
