<% content_for :title, "Dashboard" %>

<div class="flex flex-wrap items-center justify-between gap-4">
  <div>
    <h1 class="text-2xl font-bold tracking-tight text-slate-900">Dashboard</h1>
    <p class="text-sm text-slate-500"><%= l(@month.first, format: "%B %Y") %></p>
  </div>
  <div class="flex gap-3">
    <%= link_to "Add income", new_transaction_path(kind: "income"), class: "btn-secondary" %>
    <%= link_to "Add expense", new_transaction_path(kind: "expense"), class: "btn-primary" %>
  </div>
</div>

<%= render "onboarding", onboarding: @onboarding unless @onboarding.complete? %>

<% if @accounts.any? %>
  <%= form_with scope: :quick_add, url: quick_add_path, class: "card mt-6 flex flex-wrap items-end gap-3 p-4" do |f| %>
    <div class="w-28">
      <%= f.label :amount, "Spent", class: "form-label" %>
      <%= f.number_field :amount, step: "0.01", min: "0.01", required: true, class: "form-input" %>
    </div>
    <div class="min-w-48 flex-1">
      <%= f.label :description, "On", class: "form-label" %>
      <%= f.text_field :description, required: true, placeholder: "e.g. Imtiaz groceries", class: "form-input" %>
    </div>
    <div class="w-48">
      <%= f.label :account_id, "From", class: "form-label" %>
      <%= f.collection_select :account_id, @accounts, :id, :name, {}, class: "form-input" %>
    </div>
    <%= f.submit "Quick add", class: "btn-primary" %>
  <% end %>
<% end %>

<div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
  <div class="card">
    <p class="text-sm text-slate-500">Net worth</p>
    <p class="mt-1 whitespace-nowrap text-xl font-semibold xl:text-2xl"><%= money_tag(@net_worth_cents) %></p>
  </div>
  <div class="card">
    <p class="text-sm text-slate-500">Income this month</p>
    <p class="mt-1 whitespace-nowrap text-xl font-semibold xl:text-2xl"><%= money_tag(@income_cents) %></p>
  </div>
  <div class="card">
    <p class="text-sm text-slate-500">Spent this month</p>
    <p class="mt-1 whitespace-nowrap text-xl font-semibold xl:text-2xl"><%= money_tag(-@expense_cents) %></p>
  </div>
  <div class="card">
    <p class="text-sm text-slate-500">Net</p>
    <p class="mt-1 whitespace-nowrap text-xl font-semibold xl:text-2xl"><%= money_tag(@income_cents - @expense_cents) %></p>
  </div>
</div>

<% if @spending_by_category.any? %>
  <section class="card mt-6">
    <h2 class="font-semibold text-slate-900">Where the money went</h2>
    <div class="mt-4">
      <%= pie_chart @spending_by_category, donut: true, legend: "right", height: "260px",
            colors: category_chart_colors(@spending_by_category.keys),
            prefix: MoneyHelper::CURRENCY_UNITS.fetch(current_user.currency, ""), thousands: ",", round: 2 %>
    </div>
  </section>
<% end %>

<div class="mt-8 grid gap-6 lg:grid-cols-3">
  <section class="lg:col-span-2">
    <div class="mb-2 flex items-center justify-between">
      <h2 class="font-semibold text-slate-900">Recent transactions</h2>
      <%= link_to "View all", transactions_path, class: "link text-sm" %>
    </div>
    <% if @recent_transactions.any? %>
      <ul class="card divide-y divide-slate-100 p-0">
        <%= render @recent_transactions %>
      </ul>
    <% else %>
      <div class="card py-10 text-center text-sm text-slate-600">Nothing recorded yet.</div>
    <% end %>
  </section>

  <section class="space-y-6">
    <% if @upcoming.any? %>
      <div>
        <div class="mb-2 flex items-center justify-between">
          <h2 class="font-semibold text-slate-900">Coming up</h2>
          <%= link_to "Recurring", recurring_transactions_path, class: "link text-sm" %>
        </div>
        <ul class="card divide-y divide-slate-100 p-0">
          <% @upcoming.each do |item| %>
            <li id="<%= dom_id(item, :upcoming) %>" class="flex items-center justify-between px-4 py-3 text-sm">
              <span>
                <span class="text-slate-700"><%= item.description %></span>
                <span class="block text-xs text-slate-500">
                  <%= item.next_on == Date.current ? "Today" : l(item.next_on, format: "%a %-d %b") %>
                </span>
              </span>
              <%= money_tag(item.signed_amount_cents, item.account.currency, class: "font-medium") %>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <div class="mb-2 flex items-center justify-between">
        <h2 class="font-semibold text-slate-900">Budgets</h2>
        <%= link_to "All budgets", budgets_path, class: "link text-sm" %>
      </div>
      <% if @budgets.any? %>
        <ul class="card divide-y divide-slate-100 p-0">
          <%= render @budgets %>
        </ul>
      <% else %>
        <div class="card py-6 text-center text-sm">
          <%= link_to "Set a monthly budget", new_budget_path, class: "link" %>
        </div>
      <% end %>
    </div>

    <div>
      <div class="mb-2 flex items-center justify-between">
        <h2 class="font-semibold text-slate-900">Accounts</h2>
        <%= link_to "Manage", accounts_path, class: "link text-sm" %>
      </div>
      <ul class="card divide-y divide-slate-100 p-0">
        <% @accounts.each do |account| %>
          <li class="flex items-center justify-between px-4 py-3 text-sm">
            <span class="text-slate-700"><%= account.name %></span>
            <%= money_tag(account.balance_cents, account.currency, class: "font-medium") %>
          </li>
        <% end %>
        <% if @accounts.none? %>
          <li class="px-4 py-6 text-center text-sm text-slate-600">
            <%= link_to "Add your first account", new_account_path, class: "link" %>
          </li>
        <% end %>
      </ul>
    </div>
  </section>
</div>
