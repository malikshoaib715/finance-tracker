<% content_for :title, "Recurring" %>

<div class="flex items-center justify-between">
  <h1 class="text-2xl font-bold tracking-tight text-slate-900">Recurring transactions</h1>
  <%= link_to "New recurring", new_recurring_transaction_path, class: "btn-primary" %>
</div>

<% if @items.any? %>
  <ul class="card mt-6 divide-y divide-slate-100 p-0">
    <% @items.each do |item| %>
      <li id="<%= dom_id(item) %>" class="<%= "opacity-60" unless item.active? %>">
        <%= link_to edit_recurring_transaction_path(item), class: "flex items-center gap-4 px-4 py-3 hover:bg-slate-50" do %>
          <div class="min-w-0 flex-1">
            <p class="truncate text-sm font-medium text-slate-900"><%= item.description %></p>
            <p class="mt-0.5 text-xs text-slate-500">
              <%= item.frequency.humanize %> · <%= item.account.name %> ·
              <%= item.active? ? "next #{l(item.next_on, format: :long)}" : "paused" %>
            </p>
          </div>
          <%= money_tag(item.signed_amount_cents, item.account.currency, class: "text-sm font-semibold") %>
        <% end %>
      </li>
    <% end %>
  </ul>
<% else %>
  <div class="card mt-6 py-12 text-center">
    <p class="text-slate-600">Salary, rent, subscriptions — add them once and they'll be recorded for you.</p>
    <%= link_to "Add a recurring transaction", new_recurring_transaction_path, class: "btn-primary mt-4" %>
  </div>
<% end %>
