<% content_for :title, "Resend confirmation" %>

<div class="mx-auto w-full max-w-md">
  <h1 class="text-center text-2xl font-bold tracking-tight text-slate-900">Resend confirmation email</h1>

  <div class="card mt-8">
    <%= form_for(resource, as: resource_name, url: confirmation_path(resource_name), html: { method: :post, class: "space-y-5" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div>
        <%= f.label :email, class: "form-label" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-input",
              value: (resource.pending_reconfirmation? ? resource.unconfirmed_email : resource.email) %>
      </div>

      <%= f.submit "Resend confirmation", class: "btn-primary w-full" %>
    <% end %>
  </div>

  <%= render "devise/shared/links" %>
</div>
