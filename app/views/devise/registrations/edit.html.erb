<% content_for :title, "Account settings" %>

<div class="mx-auto w-full max-w-2xl space-y-8">
  <h1 class="text-2xl font-bold tracking-tight text-slate-900">Account settings</h1>

  <div class="card">
    <h2 class="text-base font-semibold text-slate-900">Profile</h2>
    <p class="mt-1 text-sm text-slate-500">Changing your email or password needs your current password.</p>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, class: "mt-6 space-y-5" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="grid gap-5 sm:grid-cols-2">
        <div>
          <%= f.label :name, class: "form-label" %>
          <%= f.text_field :name, autocomplete: "name", class: "form-input" %>
        </div>

        <div>
          <%= f.label :email, class: "form-label" %>
          <%= f.email_field :email, autocomplete: "email", class: "form-input" %>
        </div>
      </div>

      <div class="grid gap-5 sm:grid-cols-2">
        <div>
          <%= f.label :currency, "Default currency", class: "form-label" %>
          <%= f.select :currency, User::CURRENCIES, {}, class: "form-input" %>
        </div>

        <div>
          <%= f.label :time_zone, class: "form-label" %>
          <%= f.time_zone_select :time_zone, nil, {}, class: "form-input" %>
        </div>
      </div>

      <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
        <p class="text-sm text-amber-700">Waiting for confirmation of <%= resource.unconfirmed_email %></p>
      <% end %>

      <div class="grid gap-5 sm:grid-cols-2">
        <div>
          <%= f.label :password, "New password", class: "form-label" %>
          <%= f.password_field :password, autocomplete: "new-password", class: "form-input" %>
          <p class="mt-1 text-xs text-slate-500">Leave blank to keep your current password.</p>
        </div>

        <div>
          <%= f.label :password_confirmation, "Confirm new password", class: "form-label" %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-input" %>
        </div>
      </div>

      <div>
        <%= f.label :current_password, class: "form-label" %>
        <%= f.password_field :current_password, autocomplete: "current-password", class: "form-input sm:w-1/2" %>
      </div>

      <div class="flex justify-end">
        <%= f.submit "Save changes", class: "btn-primary" %>
      </div>
    <% end %>
  </div>

  <div class="card ring-rose-200">
    <h2 class="text-base font-semibold text-rose-700">Delete account</h2>
    <p class="mt-1 text-sm text-slate-600">This permanently removes your account and all of your data.</p>
    <%= button_to "Delete my account", registration_path(resource_name), method: :delete,
          form: { data: { turbo_confirm: "Delete your account and all of its data? This can't be undone." } },
          class: "btn mt-4 bg-rose-600 text-white hover:bg-rose-500" %>
  </div>
</div>
