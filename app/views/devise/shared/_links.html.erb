<div class="mt-6 space-y-2 text-center text-sm text-slate-600">
  <%- if controller_name != "sessions" %>
    <p>Already have an account? <%= link_to "Sign in", new_session_path(resource_name), class: "link" %></p>
  <% end %>

  <%- if devise_mapping.registerable? && controller_name != "registrations" %>
    <p>New here? <%= link_to "Create an account", new_registration_path(resource_name), class: "link" %></p>
  <% end %>

  <%- if devise_mapping.recoverable? && controller_name != "passwords" && controller_name != "registrations" %>
    <p><%= link_to "Forgot your password?", new_password_path(resource_name), class: "link" %></p>
  <% end %>

  <%- if devise_mapping.confirmable? && controller_name != "confirmations" %>
    <p><%= link_to "Didn't receive confirmation instructions?", new_confirmation_path(resource_name), class: "link" %></p>
  <% end %>
</div>
