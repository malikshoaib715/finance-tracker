<% content_for :title, "Know where your money goes" %>

<section class="py-12 sm:py-20 text-center">
  <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-slate-900">
    Know where your money goes
  </h1>
  <p class="mt-4 text-lg text-slate-600 max-w-2xl mx-auto">
    Track accounts, spending and budgets in one place. Import your bank statements,
    set monthly limits and see the trends that matter.
  </p>
</section>

<section class="grid gap-6 sm:grid-cols-3">
  <div class="rounded-xl bg-white p-6 shadow-sm ring-1 ring-slate-200">
    <h2 class="font-semibold text-slate-900">All your accounts</h2>
    <p class="mt-2 text-sm text-slate-600">Cash, bank, cards and wallets with live balances.</p>
  </div>
  <div class="rounded-xl bg-white p-6 shadow-sm ring-1 ring-slate-200">
    <h2 class="font-semibold text-slate-900">Budgets that warn you</h2>
    <p class="mt-2 text-sm text-slate-600">Monthly limits per category, before you overspend.</p>
  </div>
  <div class="rounded-xl bg-white p-6 shadow-sm ring-1 ring-slate-200">
    <h2 class="font-semibold text-slate-900">Reports at a glance</h2>
    <p class="mt-2 text-sm text-slate-600">Income vs expense, category breakdowns and net worth.</p>
  </div>
</section>
