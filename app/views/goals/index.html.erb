<% content_for :title, "Goals" %>

<div class="flex items-center justify-between">
  <h1 class="text-2xl font-bold tracking-tight text-slate-900">Savings goals</h1>
  <%= link_to "New goal", new_goal_path, class: "btn-primary" %>
</div>

<% if @goals.any? %>
  <ul class="mt-6 grid gap-4 md:grid-cols-2"><%= render @goals %></ul>
<% else %>
  <div class="card mt-6 py-12 text-center">
    <p class="text-slate-600">Saving for something? Set a target and watch it fill up.</p>
    <%= link_to "Set your first goal", new_goal_path, class: "btn-primary mt-4" %>
  </div>
<% end %>
