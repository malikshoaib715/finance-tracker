<li id="<%= dom_id(goal) %>" class="card">
  <div class="flex items-start justify-between gap-4">
    <div>
      <%= link_to goal.name, edit_goal_path(goal), class: "font-semibold text-slate-900 hover:underline" %>
      <p class="text-xs text-slate-500">
        <%= goal.account ? "Tracking #{goal.account.name}" : "Updated by hand" %>
        <% if goal.target_on %> · by <%= l(goal.target_on, format: :long) %><% end %>
      </p>
    </div>
    <% if goal.reached? %>
      <span class="rounded-full bg-emerald-50 px-2 py-0.5 text-xs font-medium text-emerald-700">Reached 🎉</span>
    <% end %>
  </div>

  <div class="mt-4 h-2 w-full overflow-hidden rounded-full bg-slate-100" role="progressbar"
       aria-valuenow="<%= (goal.ratio * 100).round %>" aria-valuemin="0" aria-valuemax="100">
    <div class="h-full rounded-full bg-emerald-500" style="width: <%= (goal.ratio * 100).round %>%"></div>
  </div>

  <div class="mt-2 flex items-center justify-between text-sm">
    <span class="tabular-nums text-slate-700"><%= money(goal.progress_cents) %> <span class="text-slate-400">of</span> <%= money(goal.target_cents) %></span>
    <% if (monthly = goal.monthly_needed_cents) %>
      <span class="text-xs text-slate-500">Save <%= money(monthly) %>/month to make it</span>
    <% end %>
  </div>
</li>
