<%= form_with model: goal, class: "space-y-5" do |f| %>
  <%= render "shared/form_errors", record: goal %>

  <div>
    <%= f.label :name, "What are you saving for?", class: "form-label" %>
    <%= f.text_field :name, placeholder: "e.g. Umrah, new laptop, emergency fund", class: "form-input" %>
  </div>

  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <%= f.label :target, "Target amount", class: "form-label" %>
      <%= f.number_field :target, step: "0.01", min: "0.01", value: (goal.target.round(2) if goal.target_cents), class: "form-input" %>
    </div>
    <div>
      <%= f.label :target_on, "By (optional)", class: "form-label" %>
      <%= f.date_field :target_on, class: "form-input" %>
    </div>
  </div>

  <div>
    <%= f.label :account_id, "Track with an account", class: "form-label" %>
    <%= f.collection_select :account_id, accounts, :id, :name, { include_blank: "No — I'll update the amount myself" }, class: "form-input" %>
    <p class="mt-1 text-xs text-slate-500">Linking a savings account makes progress follow its balance.</p>
  </div>

  <div>
    <%= f.label :saved, "Saved so far (if not linked)", class: "form-label" %>
    <%= f.number_field :saved, step: "0.01", min: "0", value: goal.saved.round(2), class: "form-input sm:w-1/2" %>
  </div>

  <div class="flex justify-end gap-3">
    <%= link_to "Cancel", goals_path, class: "btn-secondary" %>
    <%= f.submit "Save goal", class: "btn-primary" %>
  </div>
<% end %>
