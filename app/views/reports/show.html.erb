<% content_for :title, "Reports" %>
<% unit = MoneyHelper::CURRENCY_UNITS.fetch(current_user.currency, "") %>

<div class="flex items-center justify-between">
  <h1 class="text-2xl font-bold tracking-tight text-slate-900">Reports</h1>
  <%= link_to "Year in review", reports_year_path, class: "btn-secondary" %>
</div>

<section class="card mt-6">
  <h2 class="font-semibold text-slate-900">Income vs expenses</h2>
  <p class="text-sm text-slate-500">Last 12 months</p>
  <div class="mt-4">
    <%= column_chart @cash_flow_data, colors: [ "#10b981", "#f43f5e" ], height: "300px",
          prefix: unit, thousands: ",", round: 0 %>
  </div>
</section>

<section class="card mt-6">
  <h2 class="font-semibold text-slate-900">Net worth</h2>
  <p class="text-sm text-slate-500">
    Combined balance of your accounts at the end of each month, in <%= current_user.currency %>
    <% if @net_worth.other_currencies? %>
      — <%= @net_worth.excluded_currencies.to_sentence %> accounts aren't included until you
      <%= link_to "set an exchange rate", exchange_rates_path, class: "link" %>
    <% end %>
  </p>
  <div class="mt-4">
    <%= line_chart @net_worth_series, colors: [ "#059669" ], height: "260px", prefix: unit, thousands: ",", round: 0 %>
  </div>
</section>

<%= render "category_breakdown", breakdown: @breakdown %>
