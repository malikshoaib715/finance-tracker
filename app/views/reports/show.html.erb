<% content_for :title, "Reports" %>
<% unit = MoneyHelper::CURRENCY_UNITS.fetch(current_user.currency, "") %>

<h1 class="text-2xl font-bold tracking-tight text-slate-900">Reports</h1>

<section class="card mt-6">
  <h2 class="font-semibold text-slate-900">Income vs expenses</h2>
  <p class="text-sm text-slate-500">Last 12 months</p>
  <div class="mt-4">
    <%= column_chart @cash_flow.chart_data, colors: [ "#10b981", "#f43f5e" ], height: "300px",
          prefix: unit, thousands: ",", round: 0 %>
  </div>
</section>

<section class="card mt-6">
  <h2 class="font-semibold text-slate-900">Net worth</h2>
  <p class="text-sm text-slate-500">
    Combined balance of your <%= current_user.currency %> accounts at the end of each month
    <% if @net_worth.other_currencies? %>(accounts in other currencies aren't included)<% end %>
  </p>
  <div class="mt-4">
    <%= line_chart @net_worth.series, colors: [ "#059669" ], height: "260px", prefix: unit, thousands: ",", round: 0 %>
  </div>
</section>

<%= render "category_breakdown", breakdown: @breakdown %>
