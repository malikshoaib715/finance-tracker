<% content_for :title, "#{@review.year} in review" %>

<div class="flex items-center justify-between">
  <h1 class="text-2xl font-bold tracking-tight text-slate-900"><%= @review.year %> in review</h1>
  <div class="flex gap-2">
    <%= link_to "← #{@review.year - 1}", reports_year_path(year: @review.year - 1), class: "btn-secondary" %>
    <% if @review.year < Date.current.year %>
      <%= link_to "#{@review.year + 1} →", reports_year_path(year: @review.year + 1), class: "btn-secondary" %>
    <% end %>
  </div>
</div>

<div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
  <div class="card"><p class="text-sm text-slate-500">Earned</p><p class="mt-1 text-xl font-semibold"><%= money_tag(@review.income_cents) %></p></div>
  <div class="card"><p class="text-sm text-slate-500">Spent</p><p class="mt-1 text-xl font-semibold"><%= money_tag(-@review.expense_cents) %></p></div>
  <div class="card"><p class="text-sm text-slate-500">Kept</p><p class="mt-1 text-xl font-semibold"><%= money_tag(@review.saved_cents) %></p></div>
  <div class="card">
    <p class="text-sm text-slate-500">Savings rate</p>
    <p class="mt-1 text-xl font-semibold text-slate-900">
      <%= @review.savings_rate ? number_to_percentage(@review.savings_rate * 100, precision: 0) : "—" %>
    </p>
  </div>
</div>

<div class="mt-6 grid gap-6 lg:grid-cols-2">
  <section class="card">
    <h2 class="font-semibold text-slate-900">Biggest categories</h2>
    <ol class="mt-3 space-y-2 text-sm">
      <% @review.top_categories.each_with_index do |(name, cents), index| %>
        <li class="flex justify-between"><span><%= index + 1 %>. <%= name %></span><span class="tabular-nums"><%= money(cents) %></span></li>
      <% end %>
    </ol>
  </section>
  <section class="card">
    <h2 class="font-semibold text-slate-900">Spending by month</h2>
    <% if (month, cents = @review.biggest_month) && cents.to_i.positive? %>
      <p class="text-sm text-slate-500">Biggest: <%= month %> (<%= money(cents) %>)</p>
    <% end %>
    <div class="mt-3">
      <%= column_chart @review.monthly_expenses.transform_values { |c| c / 100.0 }, colors: [ "#f43f5e" ], height: "200px",
            prefix: MoneyHelper::CURRENCY_UNITS.fetch(current_user.currency, ""), thousands: ",", round: 0 %>
    </div>
  </section>
</div>
