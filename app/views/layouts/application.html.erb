<!DOCTYPE html>
<html class="h-full bg-slate-50">
  <head>
    <title><%= content_for?(:title) ? "#{yield(:title)} · Finance Tracker" : "Finance Tracker" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "inter-font", "data-turbo-track": "reload" %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="h-full flex flex-col text-slate-800 antialiased"
        <% if user_signed_in? %>
          data-controller="shortcuts" data-action="keydown@window->shortcuts#handle"
          data-shortcuts-new-transaction-url-value="<%= new_transaction_path %>"
        <% end %>>
    <%= render "shared/navbar" %>
    <%= render "shared/confirmation_banner" %>
    <%= render "shared/flash" %>

    <main class="flex-1 w-full max-w-6xl mx-auto px-4 sm:px-6 py-8">
      <%= yield %>
    </main>

    <%= render "shared/footer" %>
  </body>
</html>
