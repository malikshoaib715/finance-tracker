<%= form_with model: budget, class: "space-y-5" do |f| %>
  <%= render "shared/form_errors", record: budget %>
  <%= f.hidden_field :month, value: budget.month&.iso8601 %>

  <div>
    <%= f.label :category_id, "Category", class: "form-label" %>
    <%= f.collection_select :category_id, categories, :id, :name, { prompt: "Choose a category" }, class: "form-input" %>
  </div>

  <div>
    <%= f.label :amount, "Monthly limit", class: "form-label" %>
    <%= f.number_field :amount, step: "0.01", min: "0.01", value: budget.amount&.round(2), class: "form-input sm:w-1/2" %>
  </div>

  <div class="flex justify-end gap-3">
    <%= link_to "Cancel", budgets_path(month: budget.month&.strftime("%Y-%m")), class: "btn-secondary" %>
    <%= f.submit "Save budget", class: "btn-primary" %>
  </div>
<% end %>
