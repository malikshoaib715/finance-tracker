<%= form_with model: rule, class: "grid gap-3 sm:grid-cols-[1fr_1fr_auto] sm:items-end" do |f| %>
  <div class="sm:col-span-3"><%= render "shared/form_errors", record: rule %></div>

  <div>
    <%= f.label :pattern, "When the description contains", class: "form-label" %>
    <%= f.text_field :pattern, placeholder: "e.g. IMTIAZ", class: "form-input" %>
  </div>

  <div>
    <%= f.label :category_id, "File it under", class: "form-label" %>
    <%= f.select :category_id, {}, {}, class: "form-input" do %>
      <% categories.group_by(&:kind).each do |kind, list| %>
        <optgroup label="<%= kind.pluralize.humanize %>">
          <%= options_from_collection_for_select(list, :id, :name, rule.category_id) %>
        </optgroup>
      <% end %>
    <% end %>
  </div>

  <%= f.submit rule.persisted? ? "Save rule" : "Add rule", class: "btn-primary" %>
<% end %>
