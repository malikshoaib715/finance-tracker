<%= form_with model: transfer, class: "space-y-5" do |f| %>
  <%= render "shared/form_errors", record: transfer %>

  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <%= f.label :from_account_id, "From", class: "form-label" %>
      <%= f.collection_select :from_account_id, accounts, :id, :name, {}, class: "form-input" %>
    </div>

    <div>
      <%= f.label :to_account_id, "To", class: "form-label" %>
      <%= f.collection_select :to_account_id, accounts, :id, :name, {}, class: "form-input" %>
    </div>
  </div>

  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <%= f.label :amount, class: "form-label" %>
      <%= f.number_field :amount, step: "0.01", min: "0.01", autofocus: true,
            value: transfer.amount&.round(2), class: "form-input" %>
    </div>

    <div>
      <%= f.label :occurred_on, "Date", class: "form-label" %>
      <%= f.date_field :occurred_on, class: "form-input" %>
    </div>
  </div>

  <div>
    <%= f.label :description, class: "form-label" %>
    <%= f.text_field :description, placeholder: "e.g. ATM withdrawal (optional)", class: "form-input" %>
  </div>

  <div class="flex justify-end gap-3">
    <%= link_to "Cancel", transactions_path, class: "btn-secondary" %>
    <%= f.submit class: "btn-primary" %>
  </div>
<% end %>
