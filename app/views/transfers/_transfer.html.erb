<li id="<%= dom_id(transfer) %>">
  <%= link_to edit_transfer_path(transfer), class: "flex items-center gap-4 px-4 py-3 hover:bg-slate-50" do %>
    <div class="min-w-0 flex-1">
      <p class="truncate text-sm font-medium text-slate-900"><%= transfer.title %></p>
      <p class="mt-0.5 text-xs text-slate-500">
        <%= transfer.from_account.name %> &rarr; <%= transfer.to_account.name %>
      </p>
    </div>
    <span class="text-sm font-semibold tabular-nums text-slate-600">
      <%= money(transfer.amount_cents, transfer.from_account.currency) %>
    </span>
  <% end %>
</li>
