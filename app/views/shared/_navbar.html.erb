<% nav_links = [ [ "Dashboard", dashboard_path ], [ "Transactions", transactions_path ],
                 [ "Accounts", accounts_path ], [ "Categories", categories_path ] ] %>

<header class="bg-white border-b border-slate-200" data-controller="toggle">
  <nav class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
    <%= link_to root_path, class: "flex items-center gap-2 font-semibold text-slate-900" do %>
      <span class="inline-flex h-8 w-8 items-center justify-center rounded-lg bg-emerald-600 text-white text-sm font-bold">FT</span>
      <span>Finance Tracker</span>
    <% end %>

    <% if user_signed_in? %>
      <div class="flex items-center gap-6">
        <div class="hidden md:flex items-center gap-6">
          <% nav_links.each do |label, path| %>
            <%= link_to label, path, class: [ "text-sm font-medium hover:text-slate-900",
                                              current_page?(path) ? "text-slate-900" : "text-slate-600" ],
                                     aria: { current: ("page" if current_page?(path)) } %>
          <% end %>
        </div>

        <div class="relative" data-controller="dropdown"
             data-action="click@window->dropdown#closeOnClickOutside keydown.esc@window->dropdown#close">
          <button type="button" data-dropdown-target="button" data-action="dropdown#toggle"
                  aria-haspopup="true" aria-expanded="false"
                  class="flex items-center gap-2 rounded-full py-1 pl-1 pr-3 text-sm font-medium text-slate-700 hover:bg-slate-100">
            <span class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-slate-200 text-slate-700">
              <%= current_user.initials %>
            </span>
            <span class="hidden sm:inline"><%= current_user.first_name %></span>
          </button>

          <div data-dropdown-target="menu"
               class="hidden absolute right-0 z-20 mt-2 w-48 rounded-lg bg-white py-1 shadow-lg ring-1 ring-slate-200">
            <%= link_to "Account settings", edit_user_registration_path,
                  class: "block px-4 py-2 text-sm text-slate-700 hover:bg-slate-50" %>
            <%= button_to "Sign out", destroy_user_session_path, method: :delete,
                  class: "block w-full px-4 py-2 text-left text-sm text-slate-700 hover:bg-slate-50" %>
          </div>
        </div>

        <button type="button" class="md:hidden -mr-2 rounded-md p-2 text-slate-600 hover:bg-slate-100"
                data-action="toggle#toggle" aria-label="Menu" aria-expanded="false" data-toggle-target="button">
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
          </svg>
        </button>
      </div>
    <% else %>
      <div class="flex items-center gap-3">
        <%= link_to "Sign in", new_user_session_path, class: "text-sm font-medium text-slate-700 hover:text-slate-900" %>
        <%= link_to "Get started", new_user_registration_path, class: "btn-primary" %>
      </div>
    <% end %>
  </nav>

  <% if user_signed_in? %>
    <div class="hidden border-t border-slate-200 md:hidden" data-toggle-target="panel">
      <% nav_links.each do |label, path| %>
        <%= link_to label, path, class: "block px-4 py-3 text-sm font-medium text-slate-700 hover:bg-slate-50" %>
      <% end %>
    </div>
  <% end %>
</header>
