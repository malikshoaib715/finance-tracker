<div id="flash" class="fixed top-20 right-4 z-50 flex w-full max-w-sm flex-col gap-2">
  <% flash.each do |type, message| %>
    <% styles = type.to_s == "alert" ? "bg-rose-50 text-rose-800 ring-rose-200" : "bg-emerald-50 text-emerald-800 ring-emerald-200" %>
    <div data-controller="flash" role="status"
         class="flex items-start justify-between gap-3 rounded-lg px-4 py-3 text-sm shadow-sm ring-1 transition-opacity duration-300 <%= styles %>">
      <span><%= message %></span>
      <button type="button" data-action="flash#dismiss" class="opacity-60 hover:opacity-100" aria-label="Dismiss">&times;</button>
    </div>
  <% end %>
</div>
