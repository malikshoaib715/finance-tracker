<% content_for :title, "Accounts" %>

<div class="flex items-center justify-between">
  <h1 class="text-2xl font-bold tracking-tight text-slate-900">Accounts</h1>
  <%= link_to "New account", new_account_path, class: "btn-primary" %>
</div>

<% if @accounts.any? %>
  <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    <% @accounts.each do |account| %>
      <%= link_to edit_account_path(account), id: dom_id(account), class: "card block hover:ring-emerald-300 transition" do %>
        <div class="flex items-start justify-between">
          <div>
            <p class="font-semibold text-slate-900"><%= account.name %></p>
            <p class="text-xs uppercase tracking-wide text-slate-500"><%= account.kind.humanize %></p>
          </div>
          <span class="rounded bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-600"><%= account.currency %></span>
        </div>
        <p class="mt-4 text-2xl font-semibold"><%= money_tag(account.balance_cents, account.currency) %></p>
      <% end %>
    <% end %>
  </div>
<% else %>
  <div class="card mt-6 py-12 text-center">
    <p class="text-slate-600">You haven't added any accounts yet.</p>
    <%= link_to "Add your first account", new_account_path, class: "btn-primary mt-4" %>
  </div>
<% end %>

<% if @archived_accounts.any? %>
  <details class="mt-10">
    <summary class="cursor-pointer text-sm font-medium text-slate-600">Archived accounts (<%= @archived_accounts.size %>)</summary>
    <ul class="mt-3 divide-y divide-slate-200 card p-0">
      <% @archived_accounts.each do |account| %>
        <li id="<%= dom_id(account, :archived) %>" class="flex items-center justify-between px-4 py-3">
          <span class="text-slate-600"><%= account.name %></span>
          <%= button_to "Restore", account_archive_path(account), method: :delete, class: "link text-sm" %>
        </li>
      <% end %>
    </ul>
  </details>
<% end %>
