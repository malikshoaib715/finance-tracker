<% content_for :title, @account.name %>

<div class="flex flex-wrap items-start justify-between gap-4">
  <div>
    <p class="text-xs uppercase tracking-wide text-slate-500"><%= @account.kind.humanize %> · <%= @account.currency %></p>
    <h1 class="text-2xl font-bold tracking-tight text-slate-900"><%= @account.name %></h1>
    <p class="mt-1 text-3xl font-semibold"><%= money_tag(@account.balance_cents, @account.currency) %></p>
    <p class="hidden text-xs text-slate-500 print:block">Statement printed <%= l(Time.current, format: :long) %> · <%= current_user.name %></p>
  </div>
  <div class="no-print flex gap-3">
    <button type="button" onclick="window.print()" class="btn-secondary">Print statement</button>
    <%= link_to "Reconcile", new_account_reconciliation_path(@account), class: "btn-secondary" %>
    <%= link_to "Edit", edit_account_path(@account), class: "btn-secondary" %>
    <%= link_to "Add transaction", new_transaction_path, class: "btn-primary" %>
  </div>
</div>

<div class="card mt-6 overflow-hidden p-0">
  <table class="min-w-full divide-y divide-slate-200 text-sm">
    <thead class="bg-slate-50 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">
      <tr>
        <th class="px-4 py-2">Date</th>
        <th class="px-4 py-2">Description</th>
        <th class="px-4 py-2 text-right">Amount</th>
        <th class="px-4 py-2 text-right">Balance</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-100">
      <% @ledger.each do |entry| %>
        <tr id="<%= dom_id(entry.record, :ledger) %>">
          <td class="whitespace-nowrap px-4 py-2 text-slate-500"><%= l(entry.occurred_on, format: :short) %></td>
          <td class="px-4 py-2 text-slate-900"><%= entry.title %></td>
          <td class="px-4 py-2 text-right"><%= money_tag(entry.amount_cents, @account.currency) %></td>
          <td class="px-4 py-2 text-right tabular-nums text-slate-700"><%= money(entry.balance_cents, @account.currency) %></td>
        </tr>
      <% end %>
      <tr class="bg-slate-50/50">
        <td class="px-4 py-2 text-slate-500" colspan="3">Opening balance</td>
        <td class="px-4 py-2 text-right tabular-nums text-slate-700"><%= money(@account.opening_balance_cents, @account.currency) %></td>
      </tr>
    </tbody>
  </table>
</div>
