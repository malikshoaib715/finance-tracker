<%= form_with model: category, class: "space-y-5" do |f| %>
  <%= render "shared/form_errors", record: category %>

  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <%= f.label :name, class: "form-label" %>
      <%= f.text_field :name, autofocus: true, class: "form-input" %>
    </div>

    <div>
      <%= f.label :kind, "Type", class: "form-label" %>
      <%= f.select :kind, Category.kinds.keys.map { |k| [ k.humanize, k ] }, {}, class: "form-input" %>
    </div>
  </div>

  <fieldset>
    <legend class="form-label">Colour</legend>
    <div class="mt-2 flex flex-wrap gap-3">
      <% Category::COLORS.each do |color| %>
        <label class="cursor-pointer">
          <%= f.radio_button :color, color, class: "peer sr-only" %>
          <span class="flex h-8 w-8 items-center justify-center rounded-full ring-2 ring-transparent peer-checked:ring-slate-900 peer-focus-visible:ring-emerald-600">
            <span class="h-6 w-6 rounded-full <%= CategoriesHelper::DOT_CLASSES[color] %>"></span>
          </span>
          <span class="sr-only"><%= color %></span>
        </label>
      <% end %>
    </div>
  </fieldset>

  <div class="flex justify-end gap-3">
    <%= link_to "Cancel", categories_path, class: "btn-secondary" %>
    <%= f.submit class: "btn-primary" %>
  </div>
<% end %>
