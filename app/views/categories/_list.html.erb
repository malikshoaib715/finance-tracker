<div class="card p-0">
  <div class="flex items-center justify-between border-b border-slate-200 px-4 py-3">
    <h2 class="font-semibold text-slate-900"><%= title %></h2>
    <%= link_to "Add", new_category_path(kind: kind), class: "link text-sm" %>
  </div>
  <ul class="divide-y divide-slate-100">
    <% categories.each do |category| %>
      <li id="<%= dom_id(category) %>">
        <%= link_to edit_category_path(category), class: "flex items-center gap-3 px-4 py-2.5 hover:bg-slate-50" do %>
          <%= category_dot(category.color) %>
          <span class="text-sm text-slate-700"><%= category.name %></span>
        <% end %>
      </li>
    <% end %>
  </ul>
</div>
