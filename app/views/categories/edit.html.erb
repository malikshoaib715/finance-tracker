<% content_for :title, "Edit #{@category.name}" %>

<div class="mx-auto w-full max-w-xl">
  <h1 class="text-2xl font-bold tracking-tight text-slate-900">Edit category</h1>
  <div class="card mt-6">
    <%= render "form", category: @category %>
  </div>

  <div class="mt-6 flex justify-end">
    <%= button_to "Delete category", category_path(@category), method: :delete,
          form: { data: { turbo_confirm: "Delete #{@category.name}?" } },
          class: "text-sm font-medium text-rose-600 hover:text-rose-500" %>
  </div>
</div>
